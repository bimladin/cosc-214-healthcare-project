import java.util.LinkedList;

class Patient {
    int id;
    String name;
    int priority;

    public Patient(int id, String name, int priority) {
        this.id = id;
        this.name = name;
        this.priority = priority;
    }

    @Override
    public String toString() {
        return "ID: " + id + ", Name: " + name + ", Priority: " + priority;
    }
}

public class LinkedListRecords {

    private LinkedList<Patient> list;

    public LinkedListRecords() {
        list = new LinkedList<>();
    }

    // Insert Record
    public void insertRecord(Patient p) {
        list.add(p); // O(1) at end
    }

    // Search Record by ID
    public Patient searchRecord(int id) {
        for (Patient p : list) {
            if (p.id == id) {
                return p;
            }
        }
        return null; // Not found
    }

    // Delete Record by ID
    public boolean deleteRecord(int id) {
        for (Patient p : list) {
            if (p.id == id) {
                list.remove(p);
                return true;
            }
        }
        return false;
    }

    // Traverse Records
    public void traverseRecords() {
        for (Patient p : list) {
            System.out.println(p);
        }
    }

    // Benchmark Methods
    public long benchmarkInsert(int n) {
        long start = System.nanoTime();

        for (int i = 0; i < n; i++) {
            insertRecord(new Patient(i, "Patient" + i, i % 5));
        }

        long end = System.nanoTime();
        return end - start;
    }

    public long benchmarkSearch(int id) {
        long start = System.nanoTime();

        searchRecord(id);

        long end = System.nanoTime();
        return end - start;
    }

    public long benchmarkDelete(int id) {
        long start = System.nanoTime();

        deleteRecord(id);

        long end = System.nanoTime();
        return end - start;
    }
}
