import java.util.ArrayList;

class ArrayListRecords {
    ArrayList<Patient> list = new ArrayList<>();

    public void insertRecord(Patient p) {
        list.add(p);
    }

    public Patient searchRecord(int id) {
        for (Patient p : list) {
            if (p.id == id) return p;
        }
        return null;
    }

    public void deleteRecord(int id) {
        list.removeIf(p -> p.id == id);
    }

    public void traverseRecords() {
        for (Patient p : list) {
            System.out.println(p);
        }
    }
}
